        "heading_NeQAd3": {
          "type": "heading",
          "settings": {
            "heading": "<p>what this is </p>",
            "heading_size": "h1"
          }
        },
        "text_iAmKG3": {
          "type": "text",
          "settings": {
            "text": "<p>cooldown university is your chance to launch and lead a run club on your campus — backed by a national brand, real partners, and a built-in community. you’re not just joining a club. you’re running one.</p><p>this is part community, part creative project, part entrepreneurial experience.</p>"
          }
        }
      },
