          "type": "heading",
          "settings": {
            "heading": "why start one",
            "heading_size": "h1"
          }
        },
        "text_NbWeap": {
          "type": "text",
          "settings": {
            "text": "<p>starting a cooldown university chapter puts you in a real leadership role with real-world experience — the kind that actually translates after graduation.</p><p>you’ll gain hands-on experience in:</p><ul><li>marketing and social media<br/></li><li>event planning and community building<br/></li><li>leadership and team management<br/></li><li>working directly with national and local brands<br/></li><li>growing and managing something from the ground up<br/></li></ul><p>This is founder-level experience, with support.</p>",
            "text_style": "body"
          }
        }
      },
      "block_order": [
        "heading_rYECKA",
        "text_NbWeap"
