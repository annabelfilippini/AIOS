{{ 'text-and-button.css' | asset_url | stylesheet_tag }}


<div class="text-btn">
  <h4>{{ section.settings.header }}</h4>
  <a href="{{ section.settings.link }}" class="button"><span class="btn-txt">{{ section.settings.btn-txt }}</span></a>
</div>

{% schema %}
{
  "name": "Text and Button",
  "tag": "section",
  "class": "section",
  "settings": [         
      {
          "type": "text",
          "id": "header",
          "label": "Text"
        },
          {
          "type": "url",
          "id": "link",
          "label": "Button Link"
        },
          {
          "type": "text",
          "id": "btn-txt",
          "label": "Button Text"
        } 
  ],
   "blocks": [],
  "presets": [
    {
      "name": "Text and Button",
       "blocks": []
      
    }
  ]

}
{% endschema %}
