{
  "brand": {
    "name": "Vital Health",
    "descriptor": "Integrative Medicine",
    "location": "Austin, Texas",
    "locked_fields": ["brand.name", "brand.descriptor", "colors.primary", "colors.accent"]
  },
  "canvas": {
    "instagram_portrait": {
      "width": 1080,
      "height": 1350,
      "ratio": "4:5"
    }
  },
  "colors": {
    "cream": "#F5EFE0",
    "paper": "#FBF7EC",
    "primary": "#1F4D2A",
    "deep_forest": "#163820",
    "accent": "#C9A04A",
    "ink": "#2A2A26",
    "muted": "#7A776B",
    "line": "#DED3B8"
  },
  "fonts": {
    "headline_family": "Fraunces, Georgia, serif",
    "body_family": "Inter, Arial, sans-serif",
    "headline_weight": 500,
    "body_weight": 400
  },
  "style": {
    "keywords": [
      "refined editorial spacing",
      "cream paper background",
      "forest green serif headlines",
      "gold micro-rules",
      "botanical clinical still-life",
      "square buttons",
      "quiet luxury medical wellness"
    ],
    "avoid": [
      "neon wellness",
      "fitness influencer",
      "generic hospital blue",
      "overly glossy stock photos",
      "miracle claim aesthetics",
      "identical layout repeated across slides in a carousel",
      "condensed-sans stat headlines",
      "promo pricing chips or retailer co-brand rows"
    ]
  },
  "chrome": {
    "logo_path": "visual-identity/logos/vh-logo-transparent.png",
    "masthead": {
      "enabled": true,
      "labels": ["AUSTIN, TEXAS", "INTEGRATIVE MEDICINE", "SINCE 1970"]
    },
    "pagination": {
      "enabled": true,
      "style": "subtle-dots"
    }
  }
}
