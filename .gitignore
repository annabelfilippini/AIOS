# macOS
.DS_Store

# iCloud/file-sync conflict copies (e.g. "name 2.md", "name 3.json")
*[ ][2-9].*
*[ ][2-9]
*.part

# Runtime/cache folders
__pycache__/
.venv/
venv/
node_modules/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
.vercel/
.gstack/
logs/
*.log
coverage/
.next/
out/
*.tsbuildinfo
*.py[cod]

# Secrets and local environment
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
credentials.json
auth.json

# Existing standalone repositories tracked/pushed separately
knowledge/
projects/annie-intake/
projects/pickleball-portal/repo/
projects/wayloft/

# Compatibility symlink to knowledge/
wiki

# Local/generated operational caches and scratch
scratch/
_archive/
_inbox/
.playwright-mcp/
operations/git-sync/*.log
operations/automation/

# Loose generated preview/QA images dropped at repo root
/*.png
/*.jpeg
/*.jpg

# Absolute compatibility symlinks
operations/*/_active
operations/legacy-system/
