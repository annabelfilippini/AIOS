{
  // Scoped overrides for the memory store (checkpoints, archive, candidates).
  //
  // Memory logs paste arbitrary real-world content: comparison tables, inline
  // HTML, images, quoted emails. The rules below check prose/doc shape, which
  // logs legitimately violate, so they are noise here. Everything else stays
  // ON: whitespace/list structure (MD022/MD032/MD031/MD012/...) and MD041 catch
  // real, recall-breaking regressions (e.g. unclosed frontmatter) and are
  // auto-fixable.
  //
  // NOTE: a directory-level .markdownlint.jsonc REPLACES the root
  // .markdownlint-cli2.jsonc "config" block for this subtree (markdownlint-cli2
  // does not merge them), so MD013 must be re-disabled here to match repo-wide.
  "MD013": false, // line length (logs have long prose + long next-session frontmatter)
  "MD025": false, // multiple top-level headings (logs paste content with several H1s)
  "MD028": false, // blank line inside blockquote (logs quote multi-paragraph text)
  "MD033": false, // inline HTML (logs reference <hr>, <img>, code snippets)
  "MD045": false, // image alt text (logs are not an accessibility surface)
  "MD060": false  // table pipe spacing (logs paste tables without strict padding)
}
